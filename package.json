{
  "name": "jp-sentence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --no-warnings=ExperimentalWarning --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env server/index.ts",
    "dict:import": "tsx --no-warnings=ExperimentalWarning --env-file-if-exists=.env server/dict/cli.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "npm run typecheck && npm run test:dict && npm run test:analyze && npm run test:gloss && npm run test:translate && npm run test:e2e",
    "test:gloss": "tsx web/src/lib/glossFormat.test.ts",
    "test:translate": "tsx --no-warnings=ExperimentalWarning server/translate/selftest.ts",
    "test:dict": "tsx --no-warnings=ExperimentalWarning server/dict/selftest.ts",
    "test:analyze": "tsx --no-warnings=ExperimentalWarning server/analyze/selftest.ts",
    "test:e2e": "tsx --no-warnings=ExperimentalWarning server/e2e.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-serif-jp": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@sglkc/kuromoji": "^1.1.0",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
