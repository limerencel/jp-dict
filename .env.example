# ── 服务 ─────────────────────────────────────────────
PORT=8787

# 单次分析的最大字符数（超出部分会被截断并给出警告）
JP_MAX_TEXT=20000

# 词典 zip 存放目录 / 数据库目录（默认为项目下的 dictionaries、data）
# JP_DICT_DIR=D:\Dev\jp-sentence\dictionaries
# JP_DATA_DIR=D:\Dev\jp-sentence\data

# ── AI 问答（OpenAI 兼容接口）────────────────────────
# 留空则前端 AI 面板显示「未配置」，其余功能不受影响。
#
# OpenAI:     https://api.openai.com/v1
# DeepSeek:   https://api.deepseek.com/v1
# 智谱:       https://open.bigmodel.cn/api/paas/v4
# 月之暗面:   https://api.moonshot.cn/v1
# OpenRouter: https://openrouter.ai/api/v1
# Ollama:     http://localhost:11434/v1   （AI_API_KEY 随便填）
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# ── 翻译 ────────────────────────────────────
# auto = 自动选用第一个可用的，优先级：deepl > microsoft > ai > google > libre > mymemory
# 主服务商失败时会自动降级到无需密钥的备用服务商。
# google 与 mymemory 无需任何配置，ai 直接复用上面的 AI_API_KEY。
TRANSLATE_PROVIDER=auto
TRANSLATE_TARGET=zh-CN

# DeepL（免费版每月 50 万字符，key 以 :fx 结尾）
DEEPL_API_KEY=

# Microsoft 翻译（免费层每月 200 万字符）
MS_TRANSLATOR_KEY=
MS_TRANSLATOR_REGION=

# LibreTranslate（可自建，完全离线）
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# MyMemory 填邮箱可把每日额度从 5000 提到 50000 字符
MYMEMORY_EMAIL=
